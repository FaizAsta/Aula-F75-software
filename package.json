{
  "name": "aula-control",
  "productName": "Aula Control",
  "version": "1.4.7",
  "description": "Unofficial companion app for AULA F75, F75 Pro and F87 keyboards: battery, lighting effects and per-key RGB.",
  "main": "main.js",
  "author": "",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/FaizAsta/Aula-F75-software",
  "aulaControl": { "updateRepo": "FaizAsta/Aula-F75-software" },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "python3 scripts/make-icon.py",
    "screenshots": "node scripts/screenshots.js",
    "dist": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aulacontrol.app",
    "productName": "Aula Control",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "login-item.js", "updater.js", "usage.js", "RELEASE_NOTES.md", "src/**/*", "assets/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aula Control",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "Aula-Control-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Aula-Control-Portable.${ext}"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "aula-control",
      "synopsis": "Battery, lighting and per-key RGB for AULA keyboards",
      "maintainer": "Aula Control <aula-control@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "Aula-Control-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "Aula-Control-amd64.deb",
      "fpm": ["linux/99-aula-control.rules=/etc/udev/rules.d/99-aula-control.rules"]
    }
  }
}
